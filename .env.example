# .env.example
# Copy to .env and fill in.  .env is git-ignored.
DISCORD_TOKEN=your-bot-token-here

# Optional: remote token broker instead of a local token.
# AUTH_SERVER_URL=https://your-auth-server.example.com
# APP_SECRET=shared-secret

# Optional: store music/library files somewhere other than the working directory.
# DND_DATA_DIR=D:/dnd-music
